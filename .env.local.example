# Copy this file to .env.local and fill in your real keys.
# NEVER commit .env.local — it is gitignored.
ANTHROPIC_API_KEY=sk-ant-...your-key...
GROK_API_KEY=xai-...your-key...

# Stripe (test mode keys while developing — see the Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_...your-key...
# From `stripe listen` locally, or the webhook's settings page once deployed
STRIPE_WEBHOOK_SECRET=whsec_...your-secret...

# Upstash Redis (free tier is plenty) — stores pack balances, subscription
# status, and usage counters. Create a database at upstash.com/redis or via
# the Vercel Marketplace "Upstash" integration, which sets these for you.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...your-token...
