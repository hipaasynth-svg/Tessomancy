# Copy this file to .env.local and fill in your real keys.
# NEVER commit .env.local — it is gitignored.
ANTHROPIC_API_KEY=sk-ant-...your-key...
GROK_API_KEY=xai-...your-key...
# NVIDIA (build.nvidia.com) — runs the middle oracle (grounded reasoning).
# Get a key at build.nvidia.com; xAI Live Search stays as the fallback.
NVIDIA_API_KEY=nvapi-...your-key...

# Stripe (test mode keys while developing — see the Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_...your-key...
# From `stripe listen` locally, or the webhook's settings page once deployed
STRIPE_WEBHOOK_SECRET=whsec_...your-secret...

# Upstash Redis (free tier is plenty) — stores pack balances, subscription
# status, and usage counters. Create a database at upstash.com/redis or via
# the Vercel Marketplace "Upstash" integration, which sets these for you.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...your-token...

# Question Insights (separate product — see README's "Question Insights" section)
# Any Postgres works: Neon (Vercel Marketplace "Postgres"), Supabase, or your own.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# A long random secret you generate yourself (e.g. `openssl rand -hex 32`) —
# gates minting Insights API keys and fetching quarterly reports.
ADMIN_TOKEN=...a-long-random-secret...
# A separate long random secret, set as CRON_SECRET in Vercel's project
# settings too — Vercel sends it automatically on cron-triggered requests.
CRON_SECRET=...a-different-long-random-secret...
